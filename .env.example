# Postgres (docker-compose)
DATABASE_URL=postgresql://nayanam:nayanam@localhost:5432/nayanam?schema=public

# NestJS API
API_PORT=3000
API_LOG_LEVEL=debug
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8081
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nayanam-attachments
S3_ACCESS_KEY=nayanam
S3_SECRET_KEY=nayanam-secret
# Path-style addressing is required for MinIO; set to false when targeting real AWS S3.
S3_FORCE_PATH_STYLE=true

# MailHog (local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@nayanam.local

# Web
VITE_API_URL=http://localhost:3000/api/v1

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
