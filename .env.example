# Postgres (docker-compose)
DATABASE_URL=postgresql://nayanam:nayanam@localhost:5432/nayanam?schema=public

# NestJS API
API_PORT=3000
API_LOG_LEVEL=debug
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8081
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nayanam-attachments
S3_ACCESS_KEY=nayanam
S3_SECRET_KEY=nayanam-secret
# Path-style addressing is required for MinIO; set to false when targeting real AWS S3.
S3_FORCE_PATH_STYLE=true

# MailHog (local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@nayanam.local

# Settings / Phase 9
# SHA-256 salt mixed into ip_address_hash. Rotate to invalidate old device fingerprints.
SESSION_SALT=change-me-32-random-characters-xx
# Meta links surfaced in Settings -> About. Leave blank until the real URLs exist.
META_HELP_URL=
META_CONTACT_URL=
META_TERMS_URL=
META_PRIVACY_URL=
# App version (fallback to package.json via process.env.npm_package_version when unset).
APP_VERSION=

# Web
VITE_API_URL=http://localhost:3000/api/v1

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
