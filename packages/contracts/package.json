{
  "name": "@nayanam/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/generated.ts",
    "lint:spec": "redocly lint openapi.yaml",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:spec",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm lint:spec && pnpm test"
  },
  "devDependencies": {
    "@redocly/cli": "^2.29.2",
    "@vitest/coverage-v8": "catalog:",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.6.1"
  }
}
