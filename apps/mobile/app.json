{
  "expo": {
    "name": "Nayanam",
    "slug": "nayanam",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "nayanam",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nayanam.app"
    },
    "android": {
      "package": "com.nayanam.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A84FF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
