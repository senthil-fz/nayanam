// Prisma schema is INTROSPECTED from the database (`prisma db pull`) after
// Liquibase migrations have run. NEVER run `prisma migrate`.
// This file is hand-authored to match the Phase 1 Liquibase changelog;
// run `pnpm --filter @nayanam/api prisma:pull` after `pnpm dev:db:migrate` to
// regenerate it from the live schema and confirm zero drift.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model User {
  id                  String   @id @db.VarChar(26)
  email               String   @unique @db.Citext
  name                String?
  primaryCurrencyCode String?  @map("primary_currency_code") @db.Char(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  sessions                 Session[]
  memberships              HouseholdMember[]
  invitesSent              HouseholdInvite[]   @relation("InvitedBy")
  notificationTokens       NotificationToken[]
  notifications            Notification[]
  idempotencyKeys          IdempotencyKey[]
  eventsActed              Event[]             @relation("EventActor")
  attachmentsCreated       Attachment[]        @relation("AttachmentCreatedBy")
  notificationPreferences  UserNotificationPreferences?
  security                 UserSecurity?
  emailChangeRequests      EmailChangeRequest[]
  weeklySummarySends       WeeklySummarySend[]

  @@map("users")
}

model OtpCode {
  id         String    @id @db.VarChar(26)
  email      String    @db.Citext
  codeHash   String    @map("code_hash")
  purpose    String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, purpose, expiresAt], map: "idx_otp_codes_email_purpose")
  @@map("otp_codes")
}

model Session {
  id               String    @id @db.VarChar(26)
  userId           String    @map("user_id") @db.VarChar(26)
  refreshTokenHash String    @unique(map: "idx_sessions_refresh_hash") @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?   @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deviceName       String?   @map("device_name")
  deviceKind       String    @default("other") @map("device_kind")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ipAddressHash    String?   @map("ip_address_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@map("sessions")
}

model Household {
  id                  String    @id @db.VarChar(26)
  name                String
  defaultCurrencyCode String    @default("USD") @map("default_currency_code") @db.Char(3)
  iconToken           String?   @map("icon_token")
  colorToken          String?   @map("color_token")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.VarChar(26)
  updatedBy           String?   @map("updated_by") @db.VarChar(26)

  members       HouseholdMember[]
  invites       HouseholdInvite[]
  events        Event[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  transfers     Transfer[]
  notifications Notification[]
  bills         Bill[]
  billPayments  BillPayment[]
  budgets       Budget[]
  budgetThresholdNotifications BudgetThresholdNotification[]
  attachments   Attachment[]
  loans         Loan[]
  loanLumpSums  LoanLumpSum[]

  @@map("households")
}

model Account {
  id                  String    @id @db.VarChar(26)
  householdId         String    @map("household_id") @db.VarChar(26)
  nickname            String
  type                String
  currencyCode        String    @map("currency_code") @db.Char(3)
  institution         String?
  last4               String?   @db.Char(4)
  colorToken          String    @default("indigo") @map("color_token")
  iconToken           String    @default("wallet") @map("icon_token")
  openingBalanceMinor BigInt    @default(0) @map("opening_balance_minor")
  openingBalanceAt    DateTime  @default(now()) @map("opening_balance_at") @db.Timestamptz(6)
  cachedBalanceMinor  BigInt    @default(0) @map("cached_balance_minor")
  cachedBalanceAt     DateTime  @default(now()) @map("cached_balance_at") @db.Timestamptz(6)
  displayOrder        Int       @default(0) @map("display_order")
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy           String    @map("created_by") @db.VarChar(26)
  updatedBy           String    @map("updated_by") @db.VarChar(26)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household           Household    @relation(fields: [householdId], references: [id])
  transactions        Transaction[]
  sourceTransfers     Transfer[]   @relation("TransferSourceAccount")
  destinationTransfers Transfer[]  @relation("TransferDestinationAccount")
  bills               Bill[]

  @@index([householdId, displayOrder], map: "idx_accounts_household_display")
  @@index([householdId, archivedAt], map: "idx_accounts_household_archived")
  @@index([householdId], map: "idx_accounts_household")
  @@map("accounts")
}

model Category {
  id           String    @id @db.VarChar(26)
  householdId  String?   @map("household_id") @db.VarChar(26)
  key          String
  label        String
  type         String
  iconToken    String    @default("tag") @map("icon_token")
  colorToken   String    @default("graphite") @map("color_token")
  displayOrder Int       @default(0) @map("display_order")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.VarChar(26)
  updatedBy    String?   @map("updated_by") @db.VarChar(26)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household    Household?    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]
  budgets      Budget[]

  @@index([householdId, displayOrder], map: "idx_categories_household_order")
  @@index([householdId, type, archivedAt], map: "idx_categories_household_type_archived")
  @@map("categories")
}

model Transaction {
  id           String    @id @db.VarChar(26)
  householdId  String    @map("household_id") @db.VarChar(26)
  accountId    String    @map("account_id") @db.VarChar(26)
  categoryId   String    @map("category_id") @db.VarChar(26)
  type         String
  amountMinor  BigInt    @map("amount_minor")
  currencyCode String    @map("currency_code") @db.Char(3)
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  note         String?
  transferId   String?   @map("transfer_id") @db.VarChar(26)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy    String    @map("created_by") @db.VarChar(26)
  updatedBy    String    @map("updated_by") @db.VarChar(26)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id])
  account   Account   @relation(fields: [accountId], references: [id])
  category  Category  @relation(fields: [categoryId], references: [id])
  transfer   Transfer?     @relation(fields: [transferId], references: [id])
  billPayments BillPayment[]

  @@index([accountId], map: "idx_transactions_account_id")
  @@index([categoryId], map: "idx_transactions_category_id")
  @@index([householdId, occurredAt(sort: Desc)], map: "idx_transactions_household_occurred")
  @@map("transactions")
}

model Transfer {
  id                    String    @id @db.VarChar(26)
  householdId           String    @map("household_id") @db.VarChar(26)
  sourceAccountId       String    @map("source_account_id") @db.VarChar(26)
  destinationAccountId  String    @map("destination_account_id") @db.VarChar(26)
  amountMinor           BigInt    @map("amount_minor")
  currencyCode          String    @map("currency_code") @db.Char(3)
  occurredAt            DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  note                  String?
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy             String    @map("created_by") @db.VarChar(26)
  updatedBy             String    @map("updated_by") @db.VarChar(26)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household          Household   @relation(fields: [householdId], references: [id])
  sourceAccount      Account     @relation("TransferSourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount Account     @relation("TransferDestinationAccount", fields: [destinationAccountId], references: [id])
  transactions       Transaction[]

  @@index([householdId, occurredAt(sort: Desc), id(sort: Desc)], map: "idx_transfers_household_occurred")
  @@index([householdId, sourceAccountId], map: "idx_transfers_household_source")
  @@index([householdId, destinationAccountId], map: "idx_transfers_household_destination")
  @@map("transfers")
}

model HouseholdMember {
  id          String   @id @db.VarChar(26)
  householdId String   @map("household_id") @db.VarChar(26)
  userId      String   @map("user_id") @db.VarChar(26)
  role        String
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId], map: "uq_household_members_household_user")
  @@index([userId], map: "idx_hm_user")
  @@map("household_members")
}

model HouseholdInvite {
  id          String    @id @db.VarChar(26)
  householdId String    @map("household_id") @db.VarChar(26)
  email       String    @db.Citext
  role        String
  tokenHash   String    @unique @map("token_hash")
  invitedBy   String    @map("invited_by") @db.VarChar(26)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inviter   User      @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@index([householdId], map: "idx_hi_household")
  @@index([email], map: "idx_hi_email")
  @@map("household_invites")
}

model Notification {
  id          String    @id @db.VarChar(26)
  userId      String    @map("user_id") @db.VarChar(26)
  householdId String?   @map("household_id") @db.VarChar(26)
  type        String
  payload     Json      @default("{}")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  budgetThresholdNotifications BudgetThresholdNotification[]

  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_created")
  @@map("notifications")
}

model NotificationToken {
  id            String   @id @db.VarChar(26)
  userId        String   @map("user_id") @db.VarChar(26)
  platform      String
  token         String
  expoPushToken String?  @map("expo_push_token")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token], map: "uq_notification_tokens_user_token")
  @@map("notification_tokens")
}

model IdempotencyKey {
  key          String
  userId       String   @map("user_id") @db.VarChar(26)
  method       String
  path         String
  statusCode   Int      @map("status_code")
  requestHash  String   @map("request_hash") @db.Char(64)
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([createdAt], map: "idx_idempotency_keys_created_at")
  @@map("idempotency_keys")
}

model Event {
  id          String   @id @db.VarChar(26)
  householdId String   @map("household_id") @db.VarChar(26)
  actorId     String?  @map("actor_id") @db.VarChar(26)
  type        String
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor     User?     @relation("EventActor", fields: [actorId], references: [id])

  @@index([householdId, createdAt(sort: Desc)], map: "idx_events_household_created")
  @@map("events")
}

model Bill {
  id                      String    @id @db.VarChar(26)
  householdId             String    @map("household_id") @db.VarChar(26)
  name                    String
  amountMinor             BigInt    @map("amount_minor")
  currencyCode            String    @map("currency_code") @db.Char(3)
  accountId               String    @map("account_id") @db.VarChar(26)
  categoryId              String    @map("category_id") @db.VarChar(26)
  cycle                   String
  customDays              Int?      @map("custom_days")
  startAt                 DateTime  @default(now()) @map("start_at") @db.Timestamptz(6)
  nextDueAt               DateTime  @map("next_due_at") @db.Timestamptz(6)
  endAt                   DateTime? @map("end_at") @db.Timestamptz(6)
  status                  String    @default("ACTIVE")
  autoLog                 Boolean   @default(false) @map("auto_log")
  lastPaidAt              DateTime? @map("last_paid_at") @db.Timestamptz(6)
  lastNotifiedDueSoonAt   DateTime? @map("last_notified_due_soon_at") @db.Timestamptz(6)
  lastNotifiedOverdueAt   DateTime? @map("last_notified_overdue_at") @db.Timestamptz(6)
  note                    String?
  colorToken              String?   @map("color_token")
  iconToken               String?   @map("icon_token")
  displayOrder            Int       @default(0) @map("display_order")
  archivedAt              DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy               String    @map("created_by") @db.VarChar(26)
  updatedBy               String    @map("updated_by") @db.VarChar(26)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household Household     @relation(fields: [householdId], references: [id])
  account   Account       @relation(fields: [accountId], references: [id])
  category  Category      @relation(fields: [categoryId], references: [id])
  payments  BillPayment[]

  @@index([householdId, status, nextDueAt], map: "idx_bills_household_status_due")
  @@index([householdId, nextDueAt], map: "idx_bills_household_next_due")
  @@index([householdId, displayOrder], map: "idx_bills_household_display_order")
  @@index([accountId], map: "idx_bills_account")
  @@index([categoryId], map: "idx_bills_category")
  @@map("bills")
}

model BillPayment {
  id            String    @id @db.VarChar(26)
  householdId   String    @map("household_id") @db.VarChar(26)
  billId        String    @map("bill_id") @db.VarChar(26)
  transactionId String?   @map("transaction_id") @db.VarChar(26)
  cycleDueAt    DateTime  @map("cycle_due_at") @db.Timestamptz(6)
  paidAt        DateTime  @default(now()) @map("paid_at") @db.Timestamptz(6)
  amountMinor   BigInt    @map("amount_minor")
  source        String
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.VarChar(26)
  updatedBy     String?   @map("updated_by") @db.VarChar(26)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  household   Household    @relation(fields: [householdId], references: [id])
  bill        Bill         @relation(fields: [billId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([householdId, billId, cycleDueAt(sort: Desc)], map: "idx_bill_payments_bill_cycle")
  @@index([transactionId], map: "idx_bill_payments_transaction_id")
  @@map("bill_payments")
}

model Budget {
  id           String    @id @db.VarChar(26)
  householdId  String    @map("household_id") @db.VarChar(26)
  name         String
  scope        String
  categoryId   String?   @map("category_id") @db.VarChar(26)
  amountMinor  BigInt    @map("amount_minor")
  currencyCode String    @map("currency_code") @db.Char(3)
  period       String
  rollover     Boolean   @default(false)
  status       String    @default("ACTIVE")
  startAt      DateTime  @default(now()) @map("start_at") @db.Timestamptz(6)
  endAt        DateTime? @map("end_at") @db.Timestamptz(6)
  displayOrder Int       @default(0) @map("display_order")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy    String    @map("created_by") @db.VarChar(26)
  updatedBy    String    @map("updated_by") @db.VarChar(26)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household Household                     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category?                     @relation(fields: [categoryId], references: [id])
  thresholdNotifications BudgetThresholdNotification[]

  @@index([householdId, status, period], map: "idx_budgets_household_status_period")
  @@index([householdId, displayOrder], map: "idx_budgets_household_display_order")
  @@index([categoryId], map: "idx_budgets_category_id")
  @@map("budgets")
}

model BudgetThresholdNotification {
  id               String   @id @db.VarChar(26)
  householdId      String   @map("household_id") @db.VarChar(26)
  budgetId         String   @map("budget_id") @db.VarChar(26)
  periodStart      DateTime @map("period_start") @db.Timestamptz(6)
  thresholdPercent Int      @map("threshold_percent") @db.SmallInt
  firedAt          DateTime @default(now()) @map("fired_at") @db.Timestamptz(6)
  notificationId   String   @map("notification_id") @db.VarChar(26)

  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  budget       Budget       @relation(fields: [budgetId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([budgetId, periodStart, thresholdPercent], map: "ux_btn_budget_period_threshold")
  @@index([householdId, periodStart(sort: Desc)], map: "idx_btn_household_period")
  @@index([notificationId], map: "idx_budget_threshold_notifications_notification_id")
  @@map("budget_threshold_notifications")
}

model Attachment {
  id               String    @id @db.VarChar(26)
  householdId      String    @map("household_id") @db.VarChar(26)
  ownerType        String    @map("owner_type")
  ownerId          String    @map("owner_id") @db.VarChar(26)
  key              String    @unique(map: "uq_attachments_key")
  mime             String
  size             BigInt
  originalFilename String    @map("original_filename")
  thumbKey         String?   @map("thumb_key")
  width            Int?
  height           Int?
  status           String    @default("PENDING")
  createdBy        String    @map("created_by") @db.VarChar(26)
  updatedBy        String?   @map("updated_by") @db.VarChar(26)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  uploader  User      @relation("AttachmentCreatedBy", fields: [createdBy], references: [id])

  @@index([householdId, ownerType, ownerId], map: "idx_attachments_owner")
  @@index([householdId, createdAt(sort: Desc)], map: "idx_attachments_household_created")
  @@index([createdBy], map: "idx_attachments_created_by")
  @@map("attachments")
}

model UserNotificationPreferences {
  userId                         String   @id @map("user_id") @db.VarChar(26)
  pushBillsEnabled               Boolean  @default(true)  @map("push_bills_enabled")
  pushBudgetsEnabled             Boolean  @default(true)  @map("push_budgets_enabled")
  pushHouseholdActivityEnabled   Boolean  @default(true)  @map("push_household_activity_enabled")
  pushWeeklySummaryEnabled       Boolean  @default(false) @map("push_weekly_summary_enabled")
  emailBillsEnabled              Boolean  @default(false) @map("email_bills_enabled")
  emailBudgetsEnabled            Boolean  @default(false) @map("email_budgets_enabled")
  emailHouseholdActivityEnabled  Boolean  @default(false) @map("email_household_activity_enabled")
  emailWeeklySummaryEnabled      Boolean  @default(true)  @map("email_weekly_summary_enabled")
  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model UserSecurity {
  userId             String    @id @map("user_id") @db.VarChar(26)
  biometricEnabled   Boolean   @default(false) @map("biometric_enabled")
  pinHash            String?   @map("pin_hash")
  pinLastChangedAt   DateTime? @map("pin_last_changed_at") @db.Timestamptz(6)
  pinFailedAttempts  Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil     DateTime? @map("pin_locked_until") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_security")
}

model EmailChangeRequest {
  id             String    @id @db.VarChar(26)
  userId         String    @map("user_id") @db.VarChar(26)
  newEmail       String    @map("new_email") @db.Citext
  otpHash        String    @map("otp_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lastSentAt     DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_ecr_user_created")
  @@map("email_change_requests")
}

model Loan {
  id                 String    @id @db.VarChar(26)
  householdId        String    @map("household_id") @db.VarChar(26)
  name               String
  principalMinor     BigInt    @map("principal_minor")
  currencyCode       String    @map("currency_code") @db.Char(3)
  aprBps             Int       @map("apr_bps")
  termMonths         Int       @map("term_months")
  startDate          DateTime  @map("start_date") @db.Date
  paidMonths         Int       @default(0) @map("paid_months")
  extraMonthlyMinor  BigInt    @default(0) @map("extra_monthly_minor")
  note               String?
  colorToken         String?   @map("color_token")
  iconToken          String?   @map("icon_token")
  status             String    @default("ACTIVE")
  displayOrder       Int?      @map("display_order")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy          String    @map("created_by") @db.VarChar(26)
  updatedBy          String    @map("updated_by") @db.VarChar(26)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household Household     @relation(fields: [householdId], references: [id])
  lumpSums  LoanLumpSum[]

  @@index([householdId, status, displayOrder], map: "idx_loans_household_status_display")
  @@index([householdId, createdAt(sort: Desc)], map: "idx_loans_household_created")
  @@map("loans")
}

model LoanLumpSum {
  id              String    @id @db.VarChar(26)
  householdId     String    @map("household_id") @db.VarChar(26)
  loanId          String    @map("loan_id") @db.VarChar(26)
  amountMinor     BigInt    @map("amount_minor")
  appliedAtMonth  Int       @map("applied_at_month")
  note            String?
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.VarChar(26)
  updatedBy       String?   @map("updated_by") @db.VarChar(26)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id])
  loan      Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, appliedAtMonth], map: "idx_loan_lump_sums_loan_month")
  @@map("loan_lump_sums")
}

model WeeklySummarySend {
  id           String   @id @db.VarChar(26)
  userId       String   @map("user_id") @db.VarChar(26)
  weekEndingAt DateTime @map("week_ending_at") @db.Timestamptz(6)
  sentAt       DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekEndingAt], map: "uq_wss_user_week")
  @@map("weekly_summary_sends")
}

