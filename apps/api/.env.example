# =============================================================================
# Nayanam API — environment template
# Validated at boot by `apps/api/src/config/env.schema.ts` (Zod).
# Missing/short secrets abort startup. All secrets must be >= 32 characters.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
API_PORT=3000
API_LOG_LEVEL=debug

# ---- Database ----
DATABASE_URL=postgresql://nayanam:nayanam@localhost:5432/nayanam?schema=public

# ---- Auth secrets (>= 32 chars each) ----
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32+chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32+chars
# HMAC peppers (Phase 11) — rotation invalidates outstanding hashes.
OTP_PEPPER=dev-otp-pepper-change-me-please-32+chars
REFRESH_PEPPER=dev-refresh-pepper-change-me-please-32+chars
# Salt for session ip_address_hash. Rotate to invalidate device fingerprints.
SESSION_SALT=change-me-32-random-characters-xxxx
# HMAC pepper for invite tokens. Rotation invalidates outstanding invite links.
INVITE_PEPPER=change-me-at-least-32-chars-long-placeholder
# Optional: separate secret for security OTP tokens (recommended for production).
# When set, security-reset tokens are cryptographically isolated from access tokens.
# JWT_SECURITY_OTP_SECRET=

# ---- App URLs ----
WEB_URL=http://localhost:5173

# ---- CORS (CSV; rejected if empty) ----
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nayanam-attachments
S3_ACCESS_KEY=your-minio-access-key-here
S3_SECRET_KEY=your-minio-secret-key-here
# Path-style addressing required for MinIO; set to false for real AWS S3.
S3_FORCE_PATH_STYLE=true

# ---- SMTP (MailHog locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@nayanam.local
# SMTP_USER=
# SMTP_PASS=

# ---- Push notifications ----
# EXPO_ACCESS_TOKEN=
